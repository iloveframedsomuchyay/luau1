{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luauengine-site",
  "compatibility_date": "2026-08-01",

  // Static-assets-only Worker: no `main` script needed. Cloudflare serves ./dist
  // directly from its edge cache.
  "assets": {
    "directory": "./dist",
    // Serves /docs/introduction from dist/docs/introduction.html without a redirect.
    "html_handling": "auto-trailing-slash",
    // Unknown paths fall through to dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  },

  // Attach the custom domain after the zone is added to this Cloudflare account.
  // Comment this block out for the first `wrangler deploy` if the zone isn't ready
  // yet — the site will still be live on <name>.<subdomain>.workers.dev.
  "routes": [
    { "pattern": "luauengine.org", "custom_domain": true },
    { "pattern": "www.luauengine.org", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  }
}
